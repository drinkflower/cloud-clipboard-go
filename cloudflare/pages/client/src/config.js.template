const isDevelopment = process.env.NODE_ENV === 'development';
// Production builds use the configured Worker API rather than same-origin paths.
// The Worker accepts browser requests only from the configured custom domain.
const isCloudflarePages = !isDevelopment;
const workerApiBaseURL = 'https://your-api.your-domain.example/api';

export const config = {
    // API 基础路径 (将被自动更新)
    apiBaseURL: isDevelopment ? '' : workerApiBaseURL,
    
    // WebSocket 基础路径 (将被自动更新)
    wsBaseURL: isDevelopment ? '' : workerApiBaseURL,
    
    // 环境标识
    isCloudflarePages: isCloudflarePages,
    isDevelopment: isDevelopment,
    
    // 其他配置
    name: 'Cloud Clipboard',
    version: '1.0.0'
};
